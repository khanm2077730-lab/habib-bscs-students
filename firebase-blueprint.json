{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated BSCS student profile information in Cloud Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth User UID" },
        "email": { "type": "string", "description": "Student email address" },
        "displayName": { "type": "string", "description": "Student full name" },
        "rollNumber": { "type": "string", "description": "Optional BSCS student ID" },
        "createdAt": { "type": "string", "description": "Registration date timestamp" },
        "lastLoginAt": { "type": "string", "description": "Last sign-in timestamp" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz submission record with score out of 15 marks",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "description": "Subject identifier (e.g. pf-theory)" },
        "subjectName": { "type": "string", "description": "Full name of the subject" },
        "score": { "type": "number", "description": "Score achieved out of 15" },
        "totalQuestions": { "type": "number", "description": "Always 15 marks total" },
        "percentage": { "type": "number", "description": "Calculated score percentage" },
        "passed": { "type": "boolean", "description": "Whether passing criteria is met" },
        "date": { "type": "string", "description": "Submission date string" },
        "userAnswers": { "type": "object", "description": "User selected options map" }
      },
      "required": ["subjectId", "score", "totalQuestions", "percentage"]
    },
    "CompletedLesson": {
      "title": "CompletedLesson",
      "description": "Record of a lesson marked as completed by the student",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string", "description": "Identifier of the completed lesson" },
        "completedAt": { "type": "string", "description": "Completion timestamp" }
      },
      "required": ["lessonId"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Note or study material bookmarked by the student",
      "type": "object",
      "properties": {
        "noteId": { "type": "string", "description": "ID of bookmarked note" },
        "bookmarkedAt": { "type": "string", "description": "Timestamp when bookmarked" }
      },
      "required": ["noteId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private student profile document accessible strictly by the owner user UID"
    },
    "/users/{userId}/quiz_attempts/{subjectId}": {
      "schema": "QuizAttempt",
      "description": "Private quiz results record indexed by subject ID"
    },
    "/users/{userId}/completed_lessons/{lessonId}": {
      "schema": "CompletedLesson",
      "description": "Private record of completed course lessons"
    },
    "/users/{userId}/bookmarks/{noteId}": {
      "schema": "Bookmark",
      "description": "Private bookmarked notes library"
    }
  }
}
